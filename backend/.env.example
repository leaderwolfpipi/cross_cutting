# ---- core -------------------------------------------------------------------------------------------
ENV=prod                                   # prod refuses to start with the default keys below
API_KEYS=change-me-long-random-key         # comma separated; the web console asks for one
SECRET_KEY=change-me-64-random-chars       # signs media links / hand-off pages
TOKEN_ENCRYPTION_KEY=                      # Fernet key for platform tokens (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
DATA_DIR=/srv/seafood/data                 # materials, proxies, renders, covers, database (SQLite)
DATABASE_URL=                              # empty = SQLite in DATA_DIR; production: postgresql+psycopg://user:pass@host/db
PUBLIC_BASE_URL=http://192.168.1.10:8010   # reachable from operators' phones (mobile hand-off page)
CORS_ORIGINS=http://localhost:3000
IMPORT_ROOTS=/Volumes/NAS/海鲜素材          # server folders the console may import from without copying
EMBEDDED_WORKER=false                      # true = run workers inside the API process (single-machine setup)

# ---- rendering ---------------------------------------------------------------------------------------
RENDER_BACKEND=auto                        # auto | jianying | ffmpeg
JIANYING_MCP_CMD=/Applications/JianyingMe.app/Contents/MacOS/JianyingMe --mcp
RENDER_CONCURRENCY=2
HWACCEL=auto                               # auto | videotoolbox | none

# ---- copywriting -------------------------------------------------------------------------------------
COPYWRITER=template                        # template | llm (text model below; writes from the vision shot notes)
VISION_DESCRIBE=true                       # log every shot with the vision model after analysis (copy grounding)
VISION_FRAMES_PER_SHOT=3
VISION_CONCURRENCY=3

# ---- models (OpenAI-compatible) ----------------------------------------------------------------------
AGENT_MODEL_PROVIDER=deepseek              # deepseek defaults to https://api.deepseek.com/v1
AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL_NAME=deepseek-flash
AGENT_MODEL_API_KEY=
AGENT_VISION_MODEL_PROVIDER=openai         # DeepSeek reads no images; the vision model describes them
AGENT_VISION_MODEL_NAME=qwen3.8-flash      # must accept images; GET <base_url>/models lists what your key can use
AGENT_VISION_MODEL_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
AGENT_VISION_MODEL_API_KEY=

# ---- quote outro: every mixed video ends with today's confirmed quote cards ------------------------------
QUOTE_OUTRO_REQUIRED=true                  # true = refuse to generate until today's quote sheet is confirmed
QUOTE_OUTRO_MAX_PAGES=6
QUOTE_OUTRO_PAGE_S=2.8

# ---- dedup (calibrate with your own published history) ---------------------------------------------
DEDUP_SCOPE=global                         # global | platform
PLAN_MAX_PAIR_OVERLAP=0.35
PLAN_MAX_OPENING_OVERLAP=0.35
PLAN_MAX_LIBRARY_OVERLAP=0.75                # soft: steers the footage search; review flag comes from DEDUP_REVIEW_LIBRARY
DEDUP_REJECT_CONTENT=0.60
DEDUP_REVIEW_CONTENT=0.35

# ---- publishing --------------------------------------------------------------------------------------
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=
OAUTH_REDIRECT_BASE=https://your.domain    # must match the redirect URI registered on the open platforms
ACCOUNT_MIN_INTERVAL_S=600
ACCOUNT_DAILY_LIMIT=10
